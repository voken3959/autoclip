# --- Reading chat (required) ---
TWITCH_USERNAME=
# User access token with chat:read (token only, no "oauth:" prefix)
TWITCH_OAUTH_TOKEN=
TWITCH_CHANNEL=jynxzi

# --- Clipping (optional; see README section 4) ---
# From your Twitch application at https://dev.twitch.tv/console/apps (client type: Confidential)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Long random text. Needed to use the clip controls on a public site.
ADMIN_KEY=
# Public address of this app, e.g. https://autoclip-oz6y.onrender.com (Render sets RENDER_EXTERNAL_URL for you)
PUBLIC_URL=
# Only if the app can't work out the channel's Twitch ID from chat
TWITCH_BROADCASTER_ID=
# Save a clip automatically on every spike (can also be switched on from the dashboard)
AUTO_CLIP_ENABLED=false
# How much footage each clip covers, 5-60 seconds
CLIP_DURATION_SECONDS=30
# Title given to every clip. Leave empty to use the channel name.
CLIP_TITLE=
# Auto-clips are made this many seconds after chat's busiest moment of a spike.
# A clip covers CLIP_DURATION_SECONDS and ends about 5 seconds after it is made.
CLIP_DELAY_AFTER_PEAK_SECONDS=10
# Minimum seconds between two Clip now presses
CLIP_MANUAL_COOLDOWN_SECONDS=8
# Where the Twitch login is saved. Hosts that wipe their disk lose it on restart,
# so also copy the refresh token from the dashboard into TWITCH_CLIP_REFRESH_TOKEN.
TOKEN_STORE_PATH=.autoclip_tokens.json
TWITCH_CLIP_REFRESH_TOKEN=

# --- Spike detection (optional tuning) ---
# CALIBRATION_SECONDS=120
# BASELINE_WINDOW_SECONDS=300
# BASELINE_UPDATE_SECONDS=10
# SPIKE_MULTIPLIER=2.5
# SPIKE_MIN_EXTRA_MSGS_PER_SEC=5
# SPIKE_CONFIRM_SECONDS=3
# CLIP_COOLDOWN_SECONDS=90

# --- Chat contribution leaderboard (uses TWITCH_CLIENT_ID/SECRET + the chat login above) ---
# How long a message counts towards a stream's "active chatters" window.
# LEADERBOARD_WINDOW_SECONDS=300
# How often the live stream list is refreshed and chat connections re-checked.
# LEADERBOARD_REFRESH_SECONDS=60
# How many streamer channels one IRC connection joins at a time.
# LEADERBOARD_CHANNELS_PER_CONNECTION=20
# How many of the biggest live streams are tracked.
# LEADERBOARD_MAX_STREAMS=100
# How long a channel must be collecting chat before it shows a number
# (a stream that was just added shows a dash until then).
# LEADERBOARD_MIN_SAMPLE_SECONDS=60
# How long /api/leaderboard serves the same snapshot for repeated page loads.
# LEADERBOARD_SNAPSHOT_CACHE_SECONDS=10
